    <fragment
        android:id="@+id/nav_compass"
        android:name="com.example.drawer.ui.sensors.CompassFragment"
        android:label="Compass"
        tools:layout="@layout/fragment_compass" />
    <fragment
        android:id="@+id/nav_step_counter"
        android:name="com.example.drawer.ui.sensors.StepCounterFragment"
        android:label="Step Counter"
        tools:layout="@layout/fragment_step_counter" />
    <fragment
        android:id="@+id/nav_gyroscope"
        android:name="com.example.drawer.ui.sensors.GyroscopeFragment"
